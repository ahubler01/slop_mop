{
  "manifest_version": 3,
  "name": "Slop Mop",
  "version": "0.1.0",
  "description": "Scores each post on your X feed (AI-generated image + bait-like text) and shows, blurs or hides it. Needs server.py running locally.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Slop Mop",
    "default_popup": "popup.html"
  }
}
